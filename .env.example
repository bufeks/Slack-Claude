# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack User Token (xoxp-...) - Required for conversations.history on DMs
SLACK_USER_TOKEN=xoxp-your-user-token

# Your Slack User ID (e.g., U0123456789)
SLACK_USER_ID=your-user-id

# Notification channel ID (optional - for bot notifications)
NOTIFICATION_CHANNEL_ID=your-channel-id

# Check interval in minutes (default: 60)
CHECK_INTERVAL_MINUTES=60
